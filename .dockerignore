# Keep the build context small: everything here would be uploaded to the
# Docker daemon on every build, even though the Dockerfile never COPYs it.

# Raw NWP + observation caches (~570 MB) and the training frame.
data/raw/
data/processed/
# The GeoPackage is superseded by the precomputed geo assets (D-020).
data/interim/*.gpkg
data/interim/weights_*.parquet
data/interim/truth_subdivision_daily.parquet

# Docs, study materials and rendered PDFs are not part of the runtime, except
# the documents the research assistant answers from (see the Dockerfile).
docs/
notebooks/
*.md
!README.md
!LOGIC.md
!FRONTEND_LOGIC.md
!DECISIONS.md
!PRODUCT.md
!docs/PROJECT_GUIDE.md
!docs/USING_THE_VIEWS.md
!docs/RESEARCH_ASSISTANT.md

# Source control, CI and IaC.
.git/
.github/
infra/
.claude/

# Local tooling and scratch.
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.log
tests/
dist/
offline-demo/
.venv/
venv/
